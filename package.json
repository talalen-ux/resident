    "test": "npm run test:contracts && npm run test:sim",
    "simulate": "node --experimental-strip-types scripts/simulate.mjs",
    "verify:chain": "node --experimental-strip-types scripts/verify-chain.mjs",
    "backtest": "node --experimental-strip-types scripts/backtest.mjs",
    "screen": "node --experimental-strip-types scripts/screen.mjs",
    "pools": "node --experimental-strip-types scripts/pools.mjs",
