    "@ethereumjs/vm": "^10.1.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "solc": "^0.8.28",
    "tailwindcss": "^4",
